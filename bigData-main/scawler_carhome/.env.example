# 汽车之家 Cookie 配置（必填，从浏览器开发者工具获取）
# 支持多个 Cookie 轮换使用，最多 20 个
AUTOHOME_COOKIE_1=your_cookie_1
AUTOHOME_COOKIE_2=your_cookie_2
# ... 最多支持 AUTOHOME_COOKIE_20

# 兼容旧格式（单Cookie）
# AUTOHOME_COOKIE=your_cookie

# User-Agent（可选，有默认值）
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# 并发数（可选，默认1）
# MAX_CONCURRENCY=1

# 请求超时秒数（可选，默认15）
# REQUEST_TIMEOUT=15
